# Copy to .env for local development and set the same variables in your host (e.g. Vercel).
# Production values: use https://www.edrislms.com (one canonical host) for the URLs below.

# ── Database (Neon Postgres) ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.azure.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Auth (better-auth) ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Must exactly match the site origin users visit (production: https://www.edrislms.com)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# ── Public URLs ──────────────────────────────────────────────────────────
# Used for links in emails (confirm/unsubscribe/certificates)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public base URL the transcription service calls back to (production site URL)
INTERNAL_WEBHOOK_URL="https://www.edrislms.com"

# ── Security ─────────────────────────────────────────────────────────────
ARCJET_KEY=""

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=""
# Must use a domain verified in Resend
EMAIL_FROM="no-reply@edrislms.com"

# ── Storage (Tigris, S3-compatible) ──────────────────────────────────────
NEXT_PUBLIC_S3_BUCKET_NAME_IMAGES="edris-lms-fyp"
NEXT_PUBLIC_S3_DEV_URL="https://edris-lms-fyp.t3.storage.dev"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://t3.storage.dev"
AWS_ENDPOINT_URL_IAM="https://iam.storage.dev"
AWS_REGION="auto"

# ── Payments (Stripe) ────────────────────────────────────────────────────
# Test keys (sk_test_/rk_test_) for staging; live keys (sk_live_/rk_live_) for production
STRIPE_SECRET_KEY=""
# From the Stripe webhook endpoint for https://YOUR_DOMAIN/api/webhook/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=""

# ── Video (Mux) ──────────────────────────────────────────────────────────
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
# From the Mux webhook endpoint for https://YOUR_DOMAIN/api/webhooks/mux
MUX_WEBHOOK_SECRET=""
MUX_SIGNING_KEY_ID=""
# Base64-encoded RSA private key from Mux
MUX_SIGNING_PRIVATE_KEY=""

# ── Transcription service ────────────────────────────────────────────────
TRANSCRIBER_SERVICE_URL="https://transcriber.edrislms.com"
# Shared HMAC secret (min 16 chars); webhooks are rejected without it
TRANSCRIBER_SECRET=""

# ── AI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# ── Blockchain certificates (Polygon Amoy testnet) ───────────────────────
# One URL or a comma-separated list; public Amoy fallbacks are tried after these.
# (rpc-amoy.polygon.technology no longer resolves.)
POLYGON_RPC_URL="https://polygon-amoy-bor-rpc.publicnode.com,https://polygon-amoy.drpc.org"
# Wallet that owns the certificate contract; keep it funded with POL for gas
BLOCKCHAIN_PRIVATE_KEY=""
CONTRACT_ADDRESS="0x984E8900552bE43A6b94655Dd12cbcbbe87144be"
CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_BLOCK_EXPLORER="https://amoy.polygonscan.com"
# Optional: certificate verification portal linked from QR codes (defaults to the IPFS copy)
# NEXT_PUBLIC_IPFS_VERIFY_URL=""
